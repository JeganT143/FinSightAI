# Copy to .env and fill in. Only OPENAI_API_KEY is strictly required
# (the DATABASE_URL default matches docker-compose's Postgres).

OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5432/finsight

# --- Optional: model routing (ADR-4 defaults shown) ---
# SPECIALIST_MODEL=gpt-4o-mini
# SYNTHESIZER_MODEL=gpt-4o
# CRITIC_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small

# --- Optional: pipeline guardrails ---
# MAX_REVISIONS=2
# MAX_COST_USD=0.50
# AGENT_TIMEOUT_SECONDS=180

# --- Optional: operational guardrails (ADR-12) ---
# MAX_CONCURRENT_RUNS=2
# RATE_LIMIT_RUNS=10
# RATE_LIMIT_WINDOW_SECONDS=3600

# --- Optional: logging ---
# LOG_LEVEL=INFO
# LOG_FORMAT=text        # "json" for containers / log collectors

# --- Phase 2: authentication (SAAS §3) ---
# AUTH_MODE=disabled     # "clerk" in any deployed environment
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=["https://finsightai.jegant.dev"]

# --- Phase 2: billing (SAAS §4) — Stripe TEST-mode keys ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...

# --- Phase 2: async execution (SAAS §7) ---
# QUEUE_ENABLED=false    # true requires Redis + a running worker
# REDIS_URL=redis://localhost:6379/0

# --- Optional: SEC EDGAR requires a User-Agent identifying you ---
# SEC_USER_AGENT="FinSightAI/0.2 (research demo; contact: you@example.com)"
